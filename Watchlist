// ================= STATE =================
let data = null;
let filter = 'all';
let collapsed = {};
let addOpen = false;
let saveErr = false;

const TYPE_LABEL = { series: 'SERIES', movie: 'MOVIE', ova: 'OVA', manga: 'MANGA' };
const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function setSaveErr(v) {
  saveErr = v;
  const el = document.getElementById('saveErr');
  if (el) el.style.display = v ? 'block' : 'none';
}

// ================= ACTIONS =================
function toggleItem(id) {
  const it = data.items.find(i => i.id === id);
  if (it) { it.done = !it.done; saveStore(data); render(); }
}
function deleteItem(id) {
  data.items = data.items.filter(i => i.id !== id);
  const used = new Set(data.items.map(i => i.cat));
  data.categories = data.categories.filter(c => used.has(c.id) || CORE_CATS.includes(c.id));
  saveStore(data); render();
}
function toggleCat(id) { collapsed[id] = !collapsed[id]; render(); }
function setFilter(f) { filter = f; render(); }
function openAdd() { addOpen = true; render(); }
function closeAdd() { addOpen = false; render(); }
function onCatSelect(sel) {
  document.getElementById('fNewCat').style.display = sel.value === '__new__' ? 'block' : 'none';
}
function submitAdd() {
  const title = document.getElementById('fTitle').value.trim();
  const catSel = document.getElementById('fCat').value;
  const newCat = document.getElementById('fNewCat').value.trim();
  const type = document.getElementById('fType').value;
  const eps = parseInt(document.getElementById('fEps').value, 10) || 0;
  const note = document.getElementById('fNote').value.trim();
  if (!title) return;

  let catId = catSel;
  if (catSel === '__new__') {
    if (!newCat) return;
    const existing = data.categories.find(c => c.name.toLowerCase() === newCat.toLowerCase());
    if (existing) catId = existing.id;
    else {
      catId = uid('c');
      data.categories.push({ id: catId, name: newCat, ordered: false, note: '' });
    }
  }
  if (!catId) return;

  data.items.push({ id: uid('i'), cat: catId, title, type, eps, note, done: false });
  addOpen = false;
  saveStore(data); render();
}

// ================= RENDER =================
function render() {
  const app = document.getElementById('app');
  const fab = document.getElementById('fab');
  fab.style.display = addOpen ? 'none' : 'block';

  const done = data.items.filter(i => i.done).length;
  const total = data.items.length;
  const epsLeft = data.items.filter(i => !i.done).reduce((a, i) => a + (i.eps || 0), 0);

  let html = '<div class="wrap">';
  html += '<header>' +
    '<div class="eyebrow">JONATHAN / MEDIA MANIFEST</div>' +
    '<h1>Watchlist</h1>' +
    '<div class="stats">' +
      '<div><span class="stat-num">' + done + '</span><span class="stat-sub"> / ' + total + '</span><div class="stat-label">CHECKED OFF</div></div>' +
      '<div><span class="stat-num">' + epsLeft + '</span><div class="stat-label">EPISODES LEFT</div></div>' +
      '<div id="saveErr" class="save-err" style="display:' + (saveErr ? 'block' : 'none') + '">save failed — changes may not persist</div>' +
    '</div></header>';

  html += '<div class="filters">' +
    [['all','ALL'],['left','REMAINING'],['done','DONE']].map(([k,l]) =>
      '<button class="' + (filter === k ? 'active' : '') + '" onclick="setFilter(\'' + k + '\')">' + l + '</button>'
    ).join('') + '</div>';

  // add panel
  html += '<div class="add-panel' + (addOpen ? ' open' : '') + '">' +
    '<div class="panel-title">ADD TO WATCHLIST</div>' +
    '<input id="fTitle" placeholder="Title">' +
    '<div class="row2">' +
      '<select id="fCat" onchange="onCatSelect(this)"><option value="">Category…</option>' +
        data.categories.map(c => '<option value="' + c.id + '">' + esc(c.name) + '</option>').join('') +
        '<option value="__new__">+ New category</option></select>' +
      '<select id="fType" class="narrow"><option value="series">Series</option><option value="movie">Movie</option><option value="ova">OVA</option><option value="manga">Manga</option></select>' +
    '</div>' +
    '<input id="fNewCat" placeholder="New category name" style="display:none" >' +
    '<div class="row2"><input id="fEps" class="narrow" placeholder="Episodes" inputmode="numeric"><input id="fNote" placeholder="Note (optional)"></div>' +
    '<div class="btn-row"><button class="btn-primary" onclick="submitAdd()">ADD</button><button class="btn-ghost" onclick="closeAdd()">CANCEL</button></div>' +
  '</div>';

  // categories
  for (const cat of data.categories) {
    const all = data.items.filter(i => i.cat === cat.id);
    if (all.length === 0) continue;
    const shown = all.filter(i => filter === 'all' ? true : filter === 'done' ? i.done : !i.done);
    const dc = all.filter(i => i.done).length;
    const pct = all.length ? Math.round(dc / all.length * 100) : 0;
    const isCol = collapsed[cat.id];

    html += '<section class="cat">' +
      '<button class="cat-head" onclick="toggleCat(\'' + cat.id + '\')">' +
        '<div class="cat-title-row"><span class="cat-name">' + esc(cat.name) + '</span>' +
        '<span class="cat-count">' + dc + '/' + all.length + ' · ' + pct + '% ' + (isCol ? '▸' : '▾') + '</span></div>' +
        '<div class="bar"><div class="bar-fill" style="width:' + pct + '%"></div></div>' +
      '</button>';

    if (!isCol) {
      if (cat.note) html += '<div class="cat-note">' + esc(cat.note) + '</div>';
      if (shown.length === 0) {
        html += '<div class="cat-empty">' + (filter === 'done' ? 'Nothing checked off here yet.' : 'All clear.') + '</div>';
      }
      for (const it of shown) {
        const n = cat.ordered ? all.indexOf(it) + 1 : null;
        html += '<div class="item' + (it.done ? ' done' : '') + '">' +
          '<button class="check" onclick="toggleItem(\'' + it.id + '\')" aria-label="toggle">' + (it.done ? '✓' : '') + '</button>' +
          (n ? '<span class="num">' + String(n).padStart(2, '0') + '</span>' : '') +
          '<div class="body"><div class="title-row">' +
            '<span class="title">' + esc(it.title) + '</span>' +
            '<span class="tag">' + (TYPE_LABEL[it.type] || 'SERIES') + '</span>' +
            (it.eps > 0 ? '<span class="eps">' + it.eps + ' EP</span>' : '') +
          '</div>' +
          (it.note ? '<div class="note">' + esc(it.note) + '</div>' : '') +
          '</div>' +
          '<button class="del" onclick="deleteItem(\'' + it.id + '\')" aria-label="delete">×</button>' +
        '</div>';
      }
    }
    html += '</section>';
  }

  html += '</div>';
  app.innerHTML = html;
}

// ================= INIT =================
(async function init() {
  const stored = await loadStore();
  if (stored) {
    data = stored;
  } else {
    data = seedData();
    await saveStore(data);
  }
  render();
})();
</script>
</body>
</html>
