<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0B0B0C">
<title>Watchlist</title>
<style>
  :root {
    --bg: #0B0B0C; --panel: #141416; --raised: #1C1C1F;
    --border: #242428; --border-soft: #1E1E22;
    --text: #EDEDEF; --mut: #8B8B94; --faint: #55555E; --white: #FFFFFF;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans);
    padding-bottom: 110px;
    padding-top: env(safe-area-inset-top);
  }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }

  header { padding: 36px 0 20px; border-bottom: 1px solid var(--border); }
  .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.25em; color: var(--faint); margin-bottom: 8px; }
  h1 { margin: 0; font-size: 34px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .stats { display: flex; gap: 24px; margin-top: 18px; font-family: var(--mono); font-size: 12px; }
  .stat-num { color: var(--white); font-size: 20px; font-weight: 700; }
  .stat-sub { color: var(--faint); }
  .stat-label { color: var(--faint); font-size: 9px; letter-spacing: 0.15em; margin-top: 2px; }
  .save-err { color: var(--mut); font-size: 10px; align-self: center; }

  .filters { display: flex; gap: 8px; padding: 16px 0; }
  .filters button {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    padding: 7px 14px; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--border); background: transparent; color: var(--mut);
  }
  .filters button.active { border-color: var(--white); background: var(--white); color: #000; font-weight: 700; }

  .cat { background: var(--panel); border: 1px solid var(--border-soft); border-radius: 10px; margin-bottom: 14px; overflow: hidden; }
  .cat-head {
    width: 100%; background: none; border: none; cursor: pointer; text-align: left;
    padding: 14px 16px 12px; color: var(--text); display: block;
  }
  .cat-title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .cat-name { font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .cat-count { font-family: var(--mono); font-size: 11px; color: var(--faint); flex-shrink: 0; white-space: nowrap; }
  .bar { height: 2px; background: var(--raised); border-radius: 1px; margin-top: 10px; }
  .bar-fill { height: 2px; background: var(--white); border-radius: 1px; transition: width 0.3s; }
  .cat-note { padding: 0 16px 10px; font-size: 12px; color: var(--faint); font-style: italic; }
  .cat-empty { padding: 8px 16px 16px; font-family: var(--mono); font-size: 11px; color: var(--faint); }

  .item {
    display: flex; align-items: flex-start; gap: 10px; padding: 10px 16px;
    border-top: 1px solid var(--border-soft); transition: opacity 0.2s;
  }
  .item.done { opacity: 0.4; }
  .item.done .title { text-decoration: line-through; }
  .check {
    width: 20px; height: 20px; border-radius: 4px; border: 1.5px solid var(--faint);
    background: transparent; color: #000; font-size: 13px; font-weight: 800;
    line-height: 17px; cursor: pointer; flex-shrink: 0; margin-top: 1px; padding: 0;
  }
  .item.done .check { border-color: var(--white); background: var(--white); }
  .num { font-family: var(--mono); font-size: 11px; color: var(--faint); width: 18px; flex-shrink: 0; margin-top: 3px; text-align: right; }
  .body { flex: 1; min-width: 0; }
  .title-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .title { font-size: 14px; font-weight: 600; }
  .tag {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; color: var(--faint);
    border: 1px solid var(--border-soft); border-radius: 3px; padding: 1px 5px; flex-shrink: 0;
  }
  .eps { font-family: var(--mono); font-size: 10px; color: var(--faint); }
  .note { font-size: 12px; color: var(--mut); margin-top: 3px; line-height: 1.4; }
  .del { background: none; border: none; color: var(--faint); cursor: pointer; font-size: 15px; padding: 2px 6px; flex-shrink: 0; }

  .add-panel {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px; margin-bottom: 14px; display: none; flex-direction: column; gap: 10px;
  }
  .add-panel.open { display: flex; }
  .add-panel .panel-title { font-family: var(--mono); font-size: 11px; letter-spacing: 0.15em; color: var(--mut); font-weight: 700; }
  .add-panel input, .add-panel select {
    background: var(--raised); border: 1px solid var(--border); border-radius: 6px;
    color: var(--text); padding: 10px 11px; font-size: 16px; font-family: var(--sans);
    outline: none; width: 100%;
  }
  .row2 { display: flex; gap: 10px; }
  .row2 > :first-child { flex: 1; }
  .row2 > .narrow { width: 118px; flex: none; }
  .btn-row { display: flex; gap: 10px; margin-top: 4px; }
  .btn-primary {
    background: var(--white); color: #000; border: none; border-radius: 6px;
    padding: 11px 18px; font-family: var(--mono); font-size: 12px; font-weight: 800;
    letter-spacing: 0.1em; cursor: pointer;
  }
  .btn-ghost {
    background: transparent; color: var(--mut); border: 1px solid var(--border);
    border-radius: 6px; padding: 11px 18px; font-family: var(--mono); font-size: 12px;
    letter-spacing: 0.1em; cursor: pointer;
  }
